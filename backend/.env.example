DATABASE_URL=postgresql+asyncpg://reportpilot:reportpilot@localhost:5432/reportpilot
# 必填：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# 必填：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7
STORAGE_DIR=./storage

# Zabbix 默认参数（可被每个数据源 config 覆盖）
ZABBIX_DEFAULT_TIMEOUT=30
ZABBIX_MAX_RETRIES=2

# AI（OpenAI 兼容协议）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# SMTP（审核推送）
# 注：本段的 SMTP_* 与上方 AI_* 也可在「系统设置 → 运行时配置」页面直接编辑保存，
# 页面保存的值会覆盖这里的默认值（存库并以 Fernet 加密密钥类字段），无需重启服务。
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
